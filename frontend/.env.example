# ------------------------------------------------------------------
# Task Manager — frontend (Vite) environment example
# Copy to `frontend/.env` and adjust values. NEVER commit the real `.env`.
#
# NOTE: Vite reads environment variables from THIS directory at build/run
# time — the `.env` at the repository root is only used by `docker compose`.
#
# Fastest local setup: backend via `mvn spring-boot:run` (defaults to :8080)
# in backend/, frontend via `npm run dev` (http://localhost:5173).
# ------------------------------------------------------------------

# Base URL the browser uses to reach the Spring Boot API.
# For Docker/nginx the build uses "/api" instead (proxied to backend:8080).
VITE_API_URL=http://localhost:8080