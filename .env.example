# ------------------------------------------------------------------
# Task Manager — environment example
# Copy to `.env` and adjust values. NEVER commit the real `.env`.
# `docker compose` reads variables from this file automatically.
# ------------------------------------------------------------------

# --- MySQL ---
MYSQL_ROOT_PASSWORD=tasks_root_pw_change_me
MYSQL_DATABASE=taskmanager
MYSQL_USER=taskuser
MYSQL_PASSWORD=tasks_pw_change_me
DB_HOST=mysql
DB_PORT=3306
DB_NAME=taskmanager
DB_USERNAME=taskuser
DB_PASSWORD=tasks_pw_change_me

# --- Backend ---
# Cryptographically strong secret, base64 or ASCII, at least 32 bytes (256 bits) for HS256.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_generate_a_real_256bit_secret_0123456789abcdef
# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION=86400000
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SPRING_PROFILES_ACTIVE=local

# --- Frontend (local dev) ---
# The frontend owns its own environment file: see `frontend/.env.example`.
# Only `VITE_API_URL` matters there; Vite does NOT read this root `.env`.
# In Docker the frontend is built with VITE_API_URL=/api (nginx proxy), so
# no frontend variable is needed in this file.